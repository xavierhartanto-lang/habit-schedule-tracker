# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Only public values belong here. These are safe to expose to the browser;
# Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Legacy projects can use the anon key instead of the publishable key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Used for email confirmation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NEVER add the service-role / secret key with a NEXT_PUBLIC_ prefix.
# If a later phase needs it, read it only from server-only modules.

# AI (server only). Without a key the assistant shows an "AI not configured"
# state instead of replying. Never prefix these with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-opus-5-5.
# WHITESPACE_AI_MODEL=claude-opus-5-5

# Google Calendar import (server only). From Google Cloud → Google Auth
# Platform → Clients. Without these the Settings card says "Not set up yet".
# Redirect URI to register in Google: http://localhost:3000/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only if your redirect URI differs from <site>/api/google/callback.
# GOOGLE_REDIRECT_URI=
